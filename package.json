{
  "name": "@h-sanadgol/vue3-multi-calendar-datepicker",
  "packageManager": "pnpm@11.21.0",
  "description": "A simple multi-calendar datepicker component for Vue 3 and Nuxt 3.",
  "version": "2.1.1",
  "private": false,
  "files": [
    "dist/*",
    "src/*",
    "CHANGELOG.md"
  ],
  "main": "./dist/index-umd.js",
  "module": "./dist/index-es.js",
  "exports": {
    ".": {
      "import": "./dist/index-es.js",
      "require": "./dist/index-umd.js"
    },
    "./nuxt": {
      "import": "./dist/nuxt/index.mjs",
      "require": "./dist/nuxt/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:docs-demo": "vite build --config vite.docs.config.ts",
    "build:lib": "rollup -c",
    "build:nuxt": "unbuild",
    "test": "cypress run --component",
    "test:open": "cypress open --component",
    "lint": "eslint",
    "pretty": "prettier -w -u .",
    "cz": "cz",
    "build": "rimraf dist && pnpm build:nuxt && pnpm build:lib"
  },
  "homepage": "https://h-sanadgol.github.io/vue3-multi-calendar-datepicker",
  "bugs": {
    "url": "https://github.com/h-sanadgol/vue3-multi-calendar-datepicker/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/h-sanadgol/vue3-multi-calendar-datepicker.git"
  },
  "author": "Alireza Alibeiki <alibeikialireza@gmail.com> (original author)",
  "contributors": [
    "Hossain Sanadgol <h.sanadgol.s@gmail.com> (fork maintainer)"
  ],
  "keywords": [
    "javascript",
    "js",
    "vue 3",
    "nuxt 3",
    "vuejs",
    "nuxtjs",
    "date",
    "persian",
    "jalali",
    "shamsi",
    "gregorian",
    "hijri",
    "ummalqura",
    "hebrew",
    "buddhist",
    "chinese",
    "multi-calendar",
    "universal datepicker",
    "datepicker",
    "persian datepicker",
    "jalali datepicker",
    "shamsi datepicker",
    "range datepicker",
    "persian range datepicker",
    "vue datepicker",
    "vue persian datepicker",
    "vue persian range datepicker",
    "nuxt datepicker",
    "nuxt persian datepicker",
    "nuxt persian range datepicker"
  ],
  "dependencies": {
    "@alireza-ab/persian-date": "^2.6.2"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.3",
    "@cypress/vue": "^6.0.2",
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "commitizen": "^4.3.1",
    "cypress": "^15.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "rollup": "4.52.3",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.44.1",
    "unbuild": "^3.6.1",
    "vite": "^7.1.11",
    "vue": "^3.5.44",
    "vue-tsc": "^3.0.8",
    "yorkie": "^2.0.0"
  },
  "gitHooks": {
    "prepare-commit-msg": "exec < /dev/tty && cz --hook || true",
    "pre-commit": "pnpm pretty && pnpm lint"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "license": "MIT"
}
